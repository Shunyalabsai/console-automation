# Copy to .env and fill in. Never commit .env.
# Values currently mirror GitHub Actions secrets / workflow defaults.

BASE_URL=https://console.shunyalabs.ai
LOGIN_URL=https://console.shunyalabs.ai/auth/sign-in

TEST_EMAIL=
TEST_PASSWORD=

GOOGLE_APPS_SCRIPT_URL=
EMAIL_WEB_APP_URL=
REPORT_RECIPIENTS=

# Browsers to run (one Playwright project each; dashboard merges to one row per test case).
# chromium = bundled Chrome engine | chrome = installed Google Chrome (Mac/VM with Chrome) | safari = WebKit
# VM (Linux): use chromium,safari — Safari engine via webkit, not Safari.app
PLAYWRIGHT_BROWSERS=chromium,safari

# Optional overrides used by scripts/send-email-report.js
# GOOGLE_SHEETS_URL=
